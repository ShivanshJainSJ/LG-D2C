PROJECT_NAME="Livguard Quotation Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# For local development (zero configuration):
DATABASE_URL="sqlite:///./livguard.db"

# For production deployment (Neon PostgreSQL / Supabase / AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/livguard_db?sslmode=require"

ENVIRONMENT="development"
UPLOAD_DIR="./uploads"
