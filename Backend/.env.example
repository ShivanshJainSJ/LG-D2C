# ==============================================================================
# Livguard Quotation Management System - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit the real .env file or production credentials to version control.

# Application Environment: 'development', 'test', or 'production'
# In 'production', application startup will FAIL if SECRET_KEY is not configured
# or is less than 32 characters long.
ENVIRONMENT=development

PROJECT_NAME="Livguard Quotation Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Cryptographic signing secret for JWT tokens.
# Generate a secure key in production (e.g. `openssl rand -hex 32`):
SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL:
# Local development default: sqlite:///./livguard.db
# Production (e.g., Neon PostgreSQL): postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=sqlite:///./livguard.db

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Storage directory for uploaded images and public assets
UPLOAD_DIR=./uploads

# Private Document Storage Configuration:
# In development/test: 'local' (stores inside ./uploads/private_artifacts outside public static mounts)
# In production: 'r2' (Cloudflare R2 private bucket with zero egress fees)
STORAGE_BACKEND=local
PRIVATE_STORAGE_DIR=./uploads/private_artifacts

# Cloudflare R2 Credentials (required only when STORAGE_BACKEND=r2 in production):
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-private-bucket-name
# R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com

# Reverse Proxy / Forwarded Header Configuration:
# Enable TRUST_PROXY_HEADERS=true when running behind an authorized reverse proxy (e.g. Cloudflare, Nginx, Vercel)
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXIES=["127.0.0.1","::1"]
